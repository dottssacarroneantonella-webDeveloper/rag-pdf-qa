# Copia questo file in .env e modifica i valori. Il file .env NON va su GitHub.

# Dove salvare l'indice vettoriale
RAG_INDEX_DIR=data/index

# Embedding: sentence-transformers (semantico, consigliato) oppure tfidf (leggero, offline)
RAG_EMBEDDER=sentence-transformers
RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Database vettoriale: faiss oppure numpy
RAG_STORE=faiss

# LLM: ollama (locale e gratuito), openai (API compatibile) oppure echo (nessun LLM, estrattivo)
RAG_LLM=ollama
RAG_OLLAMA_MODEL=llama3.2
RAG_OLLAMA_URL=http://localhost:11434

# Solo se RAG_LLM=openai. La chiave resta qui, mai nel codice.
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_MODEL=gpt-4o-mini
RAG_OPENAI_API_KEY=

# Parametri di retrieval
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
# Lascia vuoto per usare la soglia predefinita dell'embedder (0.30 semantico, 0.10 tfidf)
RAG_MIN_SCORE=
